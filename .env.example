# ---------------------------------------------------------------------------
# Brokermogger environment configuration
#
# This file is the operator-facing catalogue for environment variables.
# `lib/config/env.ts` validates every variable with Zod at startup and
# `npm run check:env` verifies that this file, docker-compose.yml, the CI
# workflow and the README stay in sync (including test Postgres on port 5433).
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
# development | staging | production
APP_ENV=development
NODE_ENV=development
# Public base URL of this instance, used for magic links and email links.
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://brokermogger:brokermogger@localhost:5432/brokermogger?schema=public
# Separate database used by `npm run test:integration`.
TEST_DATABASE_URL=postgresql://brokermogger:brokermogger@localhost:5433/brokermogger_test?schema=public

# --- Auth.js -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-value
AUTH_URL=http://localhost:3000
# Required when running behind a reverse proxy or inside Docker.
AUTH_TRUST_HOST=true
# Magic link lifetime in seconds.
AUTH_MAGIC_LINK_TTL_SECONDS=900
# Comma separated emails that are promoted to INSTANCE_ADMIN on first sign in.
INSTANCE_ADMIN_EMAILS=

# --- Application level encryption --------------------------------------------
# Keyring of AES-256-GCM keys: "<keyId>:<base64 32 byte key>", comma separated.
# The newest key must also be referenced by ENCRYPTION_ACTIVE_KEY_ID.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEYS=v1:ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZAA=
ENCRYPTION_ACTIVE_KEY_ID=v1
# HMAC-SHA256 key for blind indexes. Rotating it invalidates equality lookups.
BLIND_INDEX_KEY=ZGV2LW9ubHktYmxpbmQtaW5kZXgtZG8tbm90LXVzZQA=

# --- Email -------------------------------------------------------------------
# mock (development and tests) | sandbox (staging) | resend (production)
EMAIL_PROVIDER=mock
EMAIL_FROM="Brokermogger <privacy@example.invalid>"
EMAIL_REPLY_TO=privacy-replies@example.invalid
# Only used by the resend provider.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Optional: verified inbound domain with Resend receiving enabled. Replies use
# private per-account aliases; full content is fetched only for a known alias.
RESEND_RECEIVING_DOMAIN=
# Sandbox provider: every outbound email is redirected to this address.
EMAIL_SANDBOX_REDIRECT_TO=
# Mock provider: directory that receives .eml style files.
MOCK_EMAIL_DIR=.mail
# Master switch. Broker emails leave the instance only when this is true AND
# the broker has production sending explicitly enabled.
ALLOW_EXTERNAL_SENDING=false

# --- Object storage ----------------------------------------------------------
# local (filesystem) | s3 (S3 compatible) | memory (tests)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=.storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=brokermogger-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Background jobs ---------------------------------------------------------
JOB_POLL_INTERVAL_MS=2000
JOB_BATCH_SIZE=5
JOB_LOCK_SECONDS=300
JOB_MAX_ATTEMPTS=5
# Docker sets a local file for its process-specific database heartbeat probe.
WORKER_HEALTH_FILE=
# Shared secret for the optional /api/jobs/tick endpoint used by external cron.
CRON_SECRET=

# --- Operations --------------------------------------------------------------
# Bearer token required by /api/metrics. Empty disables the endpoint.
METRICS_TOKEN=
RATE_LIMIT_ENABLED=true
# Shown on the public site and in the security policy.
SECURITY_CONTACT_EMAIL=security@example.invalid
