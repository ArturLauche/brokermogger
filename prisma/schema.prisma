// Brokermogger - open source privacy request desk.
//
// Design rules for this schema:
//  * Core relationships are relational. JSONB is only used for flexible metadata,
//    broker specific configuration, webhook payloads and evidence metadata.
//  * Personal identifiers are stored application-encrypted (`*Enc`) with an
//    optional HMAC blind index (`*Bi`) so equality lookups stay possible.
//  * Append-only tables (AuditLog, RemovalRequestEvent, RequestSnapshot,
//    ConsentRecord) are protected by database triggers created in the
//    `append_only_and_constraints` migration and carry a hash chain.
//  * No billing, subscription, payment or pricing entities exist by design.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  MAINTAINER
  INSTANCE_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

enum ProfileKind {
  SELF
  HOUSEHOLD_ADULT
  GUARDIAN_MANAGED_MINOR
}

enum ProfileStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

/// Consent status of a profile. GUARDIAN_MANAGED is modelled but blocked in the MVP.
enum ConsentStatus {
  SELF
  GUARDIAN_MANAGED
  EXPLICIT_CONSENT_OBTAINED
  PENDING_CONSENT
  NOT_ALLOWED
}

enum ConsentPurpose {
  PROFILE_MANAGEMENT
  REQUEST_GENERATION
  REQUEST_SUBMISSION
  IDENTITY_VERIFICATION
}

enum ConsentMethod {
  SELF_ATTESTATION
  DOUBLE_OPT_IN_EMAIL
  UPLOADED_DECLARATION
  GUARDIAN_DECLARATION
}

enum HouseholdRelationship {
  SELF
  SPOUSE_OR_PARTNER
  PARENT
  ADULT_CHILD
  SIBLING
  OTHER_ADULT
}

enum HouseholdMemberStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum HouseholdConsentStatus {
  PENDING
  VERIFIED
  DECLINED
  EXPIRED
  REVOKED
}

enum IdentifierType {
