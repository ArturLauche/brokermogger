{
  "name": "brokermogger",
  "version": "0.1.0",
  "private": true,
  "description": "Open source privacy request desk for preparing, approving, sending and tracking data broker privacy requests.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx workers/worker.ts",
    "worker:dev": "tsx watch workers/worker.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-private": "tsx scripts/backfill-private-payloads.ts",
    "db:studio": "prisma studio",
    "test": "vitest run --project unit --project components",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "node --import tsx node_modules/@playwright/test/cli.js test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "prepare:standalone": "mkdir -p .next/standalone/.next .next/standalone/public && rm -rf .next/standalone/.next/static && cp -R .next/static .next/standalone/.next/static && cp -R public/. .next/standalone/public/",
    "start:standalone": "node .next/standalone/server.js",
    "verify": "npm run check:env && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "check:env": "tsx scripts/check-env-consistency.ts",
    "check:deployment": "tsx scripts/check-deployment.ts",
    "audit:dependencies": "tsx scripts/audit-dependencies.ts",
    "test:docker": "bash scripts/docker-smoke.sh",
    "benchmark:calendar": "node --expose-gc --import tsx scripts/benchmark-calendar.ts",
    "benchmark:database": "node --expose-gc --import tsx tests/performance/database.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@hookform/resolvers": "5.9.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-table": "9.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "get-nonce": "1.0.1",
    "html-to-text": "10.0.1",
    "lucide-react": "1.59.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "resend": "6.34.1",
    "sonner": "2.0.8",
    "svix": "2.11.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/html-to-text": "9.0.4",
    "@types/node": "24.13.3",
    "@types/pdfkit": "0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jsdom": "30.1.2",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "shadcn": "4.23.1",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true,
    "unrs-resolver": true
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.1"
  }
}
