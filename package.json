{
  "name": "brokermogger",
  "version": "0.1.0",
  "private": true,
  "description": "Open source privacy request desk for preparing, approving, sending and tracking data broker privacy requests.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx workers/worker.ts",
    "worker:dev": "tsx watch workers/worker.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-private": "tsx scripts/backfill-private-payloads.ts",
    "db:studio": "prisma studio",
    "test": "vitest run --project unit --project components",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "prepare:standalone": "mkdir -p .next/standalone/.next .next/standalone/public && rm -rf .next/standalone/.next/static && cp -R .next/static .next/standalone/.next/static && cp -R public/. .next/standalone/public/",
    "start:standalone": "node .next/standalone/server.js",
    "verify": "npm run check:env && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "check:env": "tsx scripts/check-env-consistency.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@aws-sdk/client-s3": "3.1111.0",
    "@aws-sdk/s3-request-presigner": "3.1111.0",
    "@hookform/resolvers": "5.9.0",
    "@prisma/client": "6.19.3",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "html-to-text": "10.0.1",
    "lucide-react": "1.31.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "pdfkit": "0.19.1",
    "pino": "10.1.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "resend": "6.20.0",
    "sonner": "2.0.8",
    "svix": "1.99.1",
    "tailwind-merge": "3.6.0",
    "tsx": "4.23.12",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/html-to-text": "9.0.4",
    "@types/node": "24.13.3",
    "@types/pdfkit": "0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "6.19.3",
    "shadcn": "4.18.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true,
    "unrs-resolver": true,
    "msw": true
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
